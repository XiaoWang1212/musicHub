  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5C71\u702C \u65E5\u5411\u7684\u9F13\u7BC0\u594F\u7A69\u5B9A\u5168\u5834\uFF0C\u5E36\u4F86\u529B\u91CF\u8207\u652F\u6490\uFF0C\u4F7F\u5718\u968A\u7684\u5F8B\u52D5\u5B8C\u6574\u800C\u6709\u5F35\u529B\u3002\u5979\u5076\u723E\u5FAE\u5FAE\u52A0\u5F37\u64CA\u6253\uFF0C\u70BA\u6574\u500B\u6F14\u51FA\u6CE8\u5165\u81EA\u4FE1\u8207\u6D3B\u529B\u3002\r\n"
