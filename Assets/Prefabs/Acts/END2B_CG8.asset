    dialogueText: "\u89C0\u773E\u5E2D\u4E0A\u638C\u8072\u6B64\u8D77\u5F7C\u4F0F\uFF0C\u6709\u7591\u60D1\uFF0C\u4E5F\u6709\u80AF\u5B9A\uFF0C\u5E36\u8457\u5C0D\u52AA\u529B\u7684\u7406\u89E3\u3002\u767D\u77F3
