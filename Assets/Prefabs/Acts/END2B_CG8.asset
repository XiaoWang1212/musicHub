  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u66F2\u5B50\u5F9E\u526F\u6B4C\u76F4\u63A5\u5C55\u958B\uFF0C\u767D\u77F3
      \u900F\u7FBD\u7684\u6B4C\u8072\u5E36\u8457\u5FAE\u986B\u537B\u5805\u5B9A\uFF0C\u65CB\u5F8B\u6D41\u9732\u51FA\u5979\u5167\u5FC3\u7684\u60C5\u611F\u8207\u52C7\u6C23\u3002\u89C0\u773E\u80FD\u611F\u53D7\u5230\u97F3\u6A02\u4E2D\u771F\u5BE6\u7684\u60C5\u7DD2\u2014\u2014\u65E2\u6709\u52AA\u529B\uFF0C\u4E5F\u6709\u4E0D\u7518\u3002\r\n"
    expression: 
    characterAction:
      enabled: 0
      actionType: 0
      intensity: 0.005
      jumpHeight: 0.01
      duration: 0.05
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5927\u91CE \u967D\u6597\u7684\u5409\u4ED6\u5168\u529B\u8DDF\u4E0A\u65CB\u5F8B\uFF0C\u5076\u723E\u624B\u6307\u7565\u5FAE\u8D70\u97F3\uFF0C\u4F46\u6574\u9AD4\u65CB\u5F8B\u4F9D\u820A\u6E05\u6670\u6709\u529B\u3002\r\n"
    expression: 
    characterAction:
      enabled: 0
      actionType: 0
      intensity: 0.005
      jumpHeight: 0.01
      duration: 0.05
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u4E45\u6211 \u975C\u771F\u7684\u8C9D\u65AF\u7A69\u4F4F\u4F4E\u97F3\uFF0C\u4F46\u56E0\u81E8\u5834\u8ABF\u6574\uFF0C\u4ECD\u6709\u4E00\u62CD\u7565\u665A\u9032\u7684\u77AC\u9593\uFF1B\u9019\u4E9B\u5C0F\u7455\u75B5\u8B93\u97F3\u6A02\u807D\u8D77\u4F86\u751F\u52D5\u800C\u771F\u5BE6\u3002"
    expression: 
    characterAction:
      enabled: 0
      actionType: 0
      intensity: 0.005
      jumpHeight: 0.01
      duration: 0.05
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u9AD8\u5BAE \u82BD\u4F9D\u7684\u92FC\u7434\u7D30\u81A9\u800C\u654F\u92B3\uFF0C\u52AA\u529B\u8DDF\u4E0A\u7BC0\u594F\uFF0C\u5373\u4FBF\u624B\u6307\u5076\u723E\u843D\u4E0B\u5C0F\u932F\u97F3\uFF0C\u4E5F\u80FD\u88DC\u4F4D\u5176\u4ED6\u6A02\u5668\uFF0C\u8B93\u6574\u9AD4\u548C\u8AE7\u4E0D\u88AB\u6253\u7834\u3002"
