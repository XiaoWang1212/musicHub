  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5373\u4F7F\u6F14\u51FA\u4E2D\u4ECD\u6709\u5C0F\u5931\u8AA4\uFF0C\u97F3\u6A02\u4ECD\u5B8C\u6574\u6D41\u52D5\u3002\u6BCF\u500B\u4EBA\u90FD\u5728\u52AA\u529B\u914D\u5408\u3001\u4E92\u76F8\u88DC\u4F4D\uFF0C\u4E94\u4EBA\u7684\u5408\u594F\u5F62\u6210\u4E86\u4E00\u7A2E\u7DCA\u5F35\u800C\u6EAB\u6696\u7684\u5171\u9CF4\u3002\r\n"
