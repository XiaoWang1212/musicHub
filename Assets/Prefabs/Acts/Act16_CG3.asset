  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u958B\u982D\u662F\u4E45\u6211 \u975C\u771F\u7684\u8C9D\u65AF\u7DDA\uFF0C\u4F4E\u6C89\u3001\u7A69\u5B9A\uFF0C\u5982\u540C\u5FC3\u8DF3\u7684\u7BC0\u594F\uFF0C\u9396\u4F4F\u4E86\u5168\u66F2\u7684\u57FA\u8ABF\u3002"
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u7DCA\u63A5\u8457\uFF0C\u5C71\u702C \u65E5\u5411\u7684\u9F13\u9EDE\u7206\u767C\uFF0C\u5E36\u8457\u5F37\u70C8\u7684\u885D\u52C1\u548C\u9752\u6625\u7684\u6D3B\u529B\uFF0C\u96D6\u7136\u6709\u4E9B\u5730\u65B9\u7565\u986F\u7C97\u7CD9\uFF0C\u4F46\u5145\u6EFF\u611F\u67D3\u529B\u3002 "
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u5927\u91CE \u967D\u6597\u7684\u5409\u4ED6\u5207\u5165\uFF0C\u4ED6\u5F48\u594F\u7684Riff\u5145\u6EFF\u7206\u767C\u529B\uFF0C\u5E36\u8457\u4E00\u9EDE\u9EDE\u7684\u8E81\u52D5\u548C\u4E0D\u5B89\uFF0C\u50CF\u662F\u6025\u65BC\u8B49\u660E\u81EA\u5DF1\u7684\u9752\u6625\u3002"
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u9AD8\u5BAE \u82BD\u4F9D\u7684\u96FB\u92FC\u7434\u5728\u80CC\u666F\u92EA\u588A\u8457\u548C\u8072\uFF0C\u5979\u7684\u6280\u5DE7\u7CBE\u6E96\u800C\u7D2E\u5BE6\uFF0C\u70BA\u6574\u9AD4\u6DF7\u4E82\u7684\u6A02\u97F3\u63D0\u4F9B\u4E86\u4E00\u7D72\u7A69\u5B9A\u7684\u3001\u512A\u7F8E\u7684\u652F\u6490\u3002 "
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u767D\u77F3 \u900F\u7FBD\u7AD9\u5728\u805A\u5149\u71C8\u4E0B\uFF0C\u6DF1\u5438\u4E00\u53E3\u6C23\u3002\u5979\u7684\u773C\u795E\u5E36\u8457\u4E00\u7D72\u6050\u61FC\uFF0C\u4F46\u7576\u5979\u958B\u53E3\uFF0C\u4E00\u5207\u90FD\u6539\u8B8A\u4E86\u3002"
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u5979\u7684\u8072\u97F3\u662F\u4E7E\u6DE8\u3001\u6E05\u6F88\u7684\uFF0C\u5F77\u5F7F\u4E00\u9053\u6E05\u6CC9\uFF0C\u7A7F\u900F\u4E86\u6A02\u5668\u88FD\u9020\u7684\u885D\u649E\u548C\u96DC\u97F3\u3002 "
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u5979\u523B\u610F\u63A7\u5236\u4E86\u8072\u97F3\u7684\u529B\u5EA6\uFF0C\u7528\u4E00\u7A2E\u8F15\u67D4\u3001\u5167\u6582\u7684\u5531\u6CD5\uFF0C\u8B93\u6B4C\u8A5E\u4E2D\u7684\u5B64\u55AE\u6D6E\u73FE\u51FA\u4F86\u3002\u9019\u8B93\u5979\u7684\u8072\u97F3\u986F\u5F97\u6709\u4E9B\u8DDD\u96E2\u611F\u3002 "
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u96A8\u8457\u6A02\u66F2\u60C5\u7DD2\u63A8\u5411\u9AD8\u6F6E\uFF0C\u767D\u77F3
      \u900F\u7FBD\u4E0D\u5F97\u4E0D\u63D0\u5347\u97F3\u91CF\uFF0C\u4F46\u5979\u4ECD\u7136\u5728\u6975\u529B\u63A7\u5236\u81EA\u5DF1\u7684\u6280\u5DE7\u3002\u8B93\u5979\u7684\u6B4C\u8072\u64C1\u6709\u4E86\u4E00\u7A2E\u7A7F\u900F\u5168\u5834\u7684\u529B\u91CF\u3002 "
    choices: []
    useMultipleCharacters: 0
    characters:
    - characterName: "\u767D\u77F3 \u900F\u7FBD"
      position: 1
      dimCharacter: 1
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3 \u900F\u7FBD "
    dialogueText: "\u5979\u7684\u8072\u97F3\u5728\u9AD8\u97F3\u8655\u5145\u6EFF\u4E86\u60C5\u7DD2\u5F35\u529B\uFF0C\u96D6\u7136\u88AB\u5979\u52AA\u529B\u5730\u58D3\u5236\uFF0C\u4F46\u90A3\u4EFD\u529B\u91CF\u611F\u537B\u96E3\u4EE5\u63A9\u84CB\uFF0C\u8B93\u89C0\u773E\u5E2D\u5B89\u975C\u4E86\u4E00\u77AC\u3002"
