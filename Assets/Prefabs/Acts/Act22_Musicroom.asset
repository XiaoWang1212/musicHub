    characterName: "\u767D\u77F3 \u900F\u7FBD"
    dialogueText: "\u9694\u5929\uFF0C\u97F3\u6A02\u793E\u518D\u6B21\u5728\u793E\u5718\u6559\u5BA4\u96C6\u5408\u3002\u6C23\u6C1B\u96D6\u7136\u4E0D\u518D\u50CF\u6628\u5929\u90A3\u6A23\u706B\u7206\uFF0C\u4F46\u4ECD\u6709\u4E9B\u8A31\u5C37\u5C2C\u3002"
