    characterName: "\u5927\u91CE \u967D\u6597"
    dialogueText: "\u55EF\u2026\u2026\u5C0D\u4E0D\u8D77\uFF0C\u6211\u6628\u5929\u592A\u885D\u52D5\u4E86\u3002\u975C\u771F\uFF0C\u6211\u6703\u6CE8\u610F\u5927\u5BB6\u7684\u611F\u53D7\uFF0C\u6211\u5011\u4F86\u8A0E\u8AD6\u4E00\u500B\u8F2A\u6D41\u767C\u5149\u7684\u65B9\u6848\u3002"
