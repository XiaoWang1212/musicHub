  - dialogueIndex: 0
    isNarration: 0
    characterName: "\u5927\u91CE \u967D\u6597"
    dialogueText: "\u6211\u8AAA\u4E86\uFF01\u6BD4\u8CFD\u5C31\u8981\u9078\u9019\u9996\u5FEB\u6B4C\uFF01\u52A0\u4E0A\u6211\u4E09\u5206\u9418\u7684\u5409\u4ED6
      Solo \u624D\u6709\u821E\u53F0\u611F\uFF01\u4F60\u5011\u90FD\u4E0D\u61C2\u6416\u6EFE\u7CBE\u795E\uFF01"
