  - dialogueIndex: 0
    isNarration: 0
    characterName: "\u5C71\u702C \u65E5\u5411"
    dialogueText: "\u4F60\u5011\u5169\u500B\u51B7\u975C\u9EDE\u5566\uFF01\u6211\u6839\u672C\u8DDF\u4E0D\u4E0A\u4F60\u5011\u9019\u7A2E\u4E82\u4E03\u516B\u7CDF\u7684\u5B89\u6392\uFF01\u5230\u5E95\u662F\u8981\u5FEB\u9084\u662F\u8981\u7A69\uFF0C\u7D66\u500B\u6E96\u78BA\u7684\u597D\u4E0D\u597D\uFF01"
