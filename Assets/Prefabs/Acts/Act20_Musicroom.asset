    dialogueText: "\u793E\u5718\u6559\u5BA4\u5167\uFF0C\u5718\u54E1\u5011\u570D\u8457\u4E00\u5F35\u5BEB\u6EFF\u6B4C\u540D\u7684\u767D\u677F\uFF0C\u722D\u8AD6\u5DF2\u7D93\u6301\u7E8C\u4E86\u534A\u5C0F\u6642\uFF0C\u6C23\u6C1B\u50CF\u70B8\u85E5\u6876\u4E00\u6A23\uFF0C\u96A8\u6642\u6703\u5F15\u7206\u3002"
