    characterName: "\u4E45\u6211 \u975C\u771F"
    dialogueText: "\u61C2\u4EC0\u9EBC\uFF01\u4F60\u53EA\u9867\u81EA\u5DF1\uFF01\u4F60\u90A3\u6BB5
      Solo \u6703\u8B93\u6574\u9996\u6B4C\u7BC0\u594F\u5D29\u6F70\uFF01\u6211\u63D0\u9192\u4F60\u4E0D\u8981\u53EA\u770B\u821E\u53F0\u6548\u679C\uFF0C\u800C\u662F\u770B\u6574\u500B\u6A02\u968A\u7684\u5354\u8ABF\u6027\uFF01"
