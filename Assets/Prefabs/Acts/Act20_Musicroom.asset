    dialogueText: "\u5718\u54E1\u5404\u81EA\u5E36\u8457\u6012\u6C23\u96E2\u958B\u793E\u5718\u6559\u5BA4\u3002\u767D\u77F3\u77E5\u9053\u81EA\u5DF1\u4E0D\u80FD\u8B93\u88C2\u75D5\u64F4\u5927\uFF0C\u5979\u8DDF\u8457\u96E2\u958B\uFF0C\u5728\u6821\u5712\u4E2D\u9010\u4E00\u9047\u5230\u4ED6\u5011\u3002 "
