    dialogueText: "\u6700\u5F8C\u4E00\u523B\uFF0C\u767D\u77F3 \u900F\u7FBD\u653E\u4E0B\u5409\u4ED6\uFF0C\u6DF1\u547C\u5438\u3002\u5176\u4ED6\u5718\u54E1\u4E92\u770B\u5F7C\u6B64\uFF0C\u96D6\u7136\u5FC3\u4E2D\u4ECD\u6709\u4E0D\u7518\u8207\u88C2\u75D5\uFF0C\u4F46\u4ED6\u5011\u5728\u821E\u53F0\u4E0A\u5171\u540C\u5B8C\u6210\u4E86\u9019\u6BB5\u97F3\u6A02\uFF0C\u9019\u4EFD\u771F\u5BE6\u8207\u52C7\u6C23\u6210\u70BA\u5C6C\u65BC\u4ED6\u5011\u7684\u9752\u6625\u5370\u8A18"
