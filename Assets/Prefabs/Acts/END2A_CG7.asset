  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u821E\u53F0\u4E0A\u7684\u97F3\u6A02\u7D50\u675F\u6642\uFF0C\u96D6\u7136\u5B8C\u7F8E\u7121\u7455\u4E26\u672A\u9054\u6210\uFF0C\u4F46\u6BCF\u500B\u4EBA\u90FD\u611F\u53D7\u5230\u81EA\u5DF1\u548C\u5718\u968A\u7684\u52AA\u529B\uFF0C\u5167\u5FC3\u540C\u6642\u6E67\u73FE\u4E00\u7A2E\u8907\u96DC\u7684\u907A\u61BE\u2014\u2014\u52AA\u529B\u904E\u4E86\uFF0C\u537B\u9084\u662F\u6709\u6240\u7F3A\u5931\u3002\r\n"
