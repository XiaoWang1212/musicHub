  dialogues:
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u821E\u53F0\u71C8\u5149\u6253\u4E0B\uFF0C\u97F3\u6A02\u793E\u7684\u4E94\u500B\u4EBA\u4E2D\uFF0C\u9F13\u624B\u5C71\u702C
      \u65E5\u5411\u7F3A\u5E2D\uFF0C\u7559\u4E0B\u7A7A\u7F3A\u7684\u7BC0\u594F\u3002\u4E3B\u89D2\u767D\u77F3
      \u900F\u7FBD\u6DF1\u5438\u4E00\u53E3\u6C23\u8D70\u4E0A\u821E\u53F0\u3002\r\n"
    expression: "\u59D4\u5C48"
    characterAction:
      enabled: 0
      actionType: 1
      intensity: 0.3
      jumpHeight: 0.2
      duration: 0.1
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u6F14\u51FA\u958B\u59CB\uFF0C\u767D\u77F3 \u900F\u7FBD\u7684\u6B4C\u8072\u5E36\u8457\u5FAE\u986B\u537B\u5805\u5B9A\uFF0C\u65CB\u5F8B\u6D41\u9732\u51FA\u5979\u5167\u5FC3\u7684\u60C5\u611F\u8207\u52C7\u6C23\u3002\u5409\u4ED6\u624B\u5927\u91CE
      \u967D\u6597\u5168\u529B\u8DDF\u4E0A\u767D\u77F3 \u900F\u7FBD\u7684\u7BC0\u594F\uFF0C\u4F46\u5076\u723E\u4ECD\u6703\u56E0\u7F3A\u5C11\u9F13\u624B\u800C\u7A0D\u5FAE\u932F\u4F4D\u3002\r\r\n"
    expression: "\u59D4\u5C48"
    characterAction:
      enabled: 0
      actionType: 1
      intensity: 0.3
      jumpHeight: 0.2
      duration: 0.1
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u8C9D\u65AF\u624B\u4E45\u6211 \u975C\u771F\u76E1\u91CF\u7A69\u4F4F\u4F4E\u97F3\u3002\u92FC\u7434\u624B\u9AD8\u5BAE
      \u82BD\u4F9D\u8F15\u8F15\u64A5\u52D5\u7434\u9375\uFF0C\u96D6\u7136\u6280\u8853\u7CBE\u6E96\uFF0C\u4F46\u795E\u60C5\u7565\u986F\u7DCA\u5F35\uFF0C\u66F2\u5B50\u4E2D\u7684\u5C0F\u843D\u5DEE\u96B1\u7D04\u53EF\u898B\u3002\r\n"
    expression: "\u59D4\u5C48"
    characterAction:
      enabled: 0
      actionType: 1
      intensity: 0.3
      jumpHeight: 0.2
      duration: 0.1
    choices: []
    useMultipleCharacters: 0
    characters: []
    voiceClip: {fileID: 0}
    backgroundMusic: {fileID: 0}
    effect: 0
    dimCharacter: 0
  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5373\u4F7F\u51FA\u73FE\u9019\u4E9B\u5C0F\u7455\u75B5\uFF0C\u97F3\u6A02\u4ECD\u5B8C\u6574\u6D41\u52D5\uFF0C\u6BCF\u500B\u4EBA\u90FD\u5728\u52AA\u529B\u914D\u5408\uFF0C\u4E92\u76F8\u88DC\u4F4D\u3002\r\n\u89C0\u773E\u5E2D\u4E0A\uFF0C\u638C\u8072\u8207\u4F4E\u8072\u7684\u8B9A\u5606\u4EA4\u932F\uFF0C\u6C23\u6C1B\u5E36\u8457\u80AF\u5B9A\u3002\r\n"
    expression: "\u59D4\u5C48"
