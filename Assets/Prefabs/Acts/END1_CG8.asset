  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5979\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u805A\u5149\u71C8\u532F\u805A\u5728\u5979\u8EAB\u4E0A\uFF0C\u96A8\u8457\u6A02\u66F2\u524D\u594F\u7684\u6E67\u73FE\uFF0C\u5979\u7684\u6B4C\u8072\u5982\u540C\u88AB\u91CB\u653E\u7684\u9748\u9B42\uFF0C\u5E36\u8457\u4E3B\u89D2\u7279\u6709\u7684\u60C5\u611F\u5F35\u529B\u6D41\u51FA\u3002\r\n"
