    dialogueText: "\u9AD8\u5BAE \u82BD\u4F9D\u7684\u92FC\u7434\u7D30\u81A9\u800C\u654F\u92B3\uFF0C\u5979\u7684\u9375\u76E4\u97F3\u8272\u5982\u9583\u720D\u7684\u661F\u5149\uFF0C\u6070\u5230\u597D\u8655\u5730\u586B\u88DC\u4E86\u6A02\u66F2\u4E2D\u7684\u7A7A\u9593\uFF0C\u50CF\u4E00\u689D\u83EF\u9E97\u7684\u7D72\u5E36\u74B0\u7E5E\u8457\u4E3B\u5531\u7684\u65CB\u5F8B\u3002"
