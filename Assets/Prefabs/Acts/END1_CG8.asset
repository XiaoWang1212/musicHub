  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5979\u7684\u97F3\u57DF\u5BEC\u5EE3\uFF0C\u97F3\u8272\u6E05\u4EAE\u800C\u5BCC\u6709\u7A7F\u900F\u529B\uFF0C\u6700\u521D\u662F\u8F15\u67D4\u3001\u4E7E\u6DE8\u7684\u6558\u4E8B\uFF0C\u96A8\u5F8C\u5728\u526F\u6B4C\u8F49\u70BA\u6FC0\u6602\u78C5\u7934\u7684\u529B\u91CF\u3002"
