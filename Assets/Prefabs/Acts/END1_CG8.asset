  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5979\u7CBE\u6E96\u7684\u6C23\u606F\u63A7\u5236\u8B93\u9577\u97F3\u5145\u6EFF\u611F\u67D3\u529B\uFF0C\u9AD8\u97F3\u5340\u66F4\u662F\u5982\u540C\u7834\u66C9\u6642\u5206\u7684\u7B2C\u4E00\u9053\u5149\uFF0C\u65E2\u6EAB\u6696\u53C8\u5805\u5B9A\uFF0C\u5B8C\u7F8E\u8A6E\u91CB\u51FA\u9752\u6625\u71B1\u8840\u8207\u8FFD\u9010\u5922\u60F3\u7684\u71B1\u5FF1\uFF0C\u7262\u7262\u6293\u4F4F\u4E86\u5168\u5834\u7684\u6CE8\u610F\u529B\u3002"
