  - dialogueIndex: 0
    isNarration: 1
    characterName: 
    dialogueText: "\u5927\u91CE\u7684\u5409\u4ED6\u7BC0\u594F\u6E96\u78BA\u6709\u529B\uFF0C\u4ED6\u7684\u65CB\u5F8B\u7DDA\u4E0D\u50C5\u662F\u7CBE\u6E96\u7684\u4F34\u594F\uFF0C\u66F4\u50CF\u662F\u4E00\u689D\u71BE\u71B1\u7684\u8108\u7D61\uFF0C\u8207\u767D\u77F3
