  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3"
    dialogueText: "\u767D\u77F3\u9ED8\u9ED8\u5750\u5728\u89D2\u843D\uFF0C\u770B\u8457\u4ED6\u5011\u722D\u8AD6\u7DE8\u5236\u3001\u7DF4\u7FD2\u6642\u9593\u3001\u821E\u53F0\u66F2\u98A8\u3002\u5979\u65E9\u5C31\u5B78\u6703\u4E86\u5728\u55A7\u9B27\u88E1\u8B93\u601D\u7DD2\u51FA\u8D70\u3002 "
