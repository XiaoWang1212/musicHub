  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3"
    dialogueText: "\u53EA\u662F\u4ECA\u5929\u6BD4\u5E73\u5E38\u66F4\u71B1\u9B27\u3002\u684C\u4E0A\u653E\u8457\u4E00\u4EFD\u516C\u6587\u3002
