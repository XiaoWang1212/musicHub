  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3"
    dialogueText: "\u793E\u8FA6\u88E1\u5F88\u5435\uFF0C\u4F46\u5979\u7E3D\u662F\u50CF\u900F\u660E\u4EBA\u4E00\u6A23\u4E0D\u88AB\u6CE8\u610F\u2026\u6216\u8005\u8AAA\uFF0C\u5979\u523B\u610F\u8B93\u81EA\u5DF1\u4E0D\u88AB\u6CE8\u610F\u3002 "
