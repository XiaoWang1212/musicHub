  - dialogueIndex: 0
    isNarration: 1
    characterName: "\u767D\u77F3"
    dialogueText: "\u4E94\u4EBA\u570D\u8457\u516C\u6587\u8A0E\u8AD6\uFF0C\u6559\u5BA4\u5167\u5145\u65A5\u8457\u722D\u5435\u8207\u7B11\u8072\uFF0C\u53EA\u6709\u767D\u77F3\u5728\u89D2\u843D\u4FDD\u6301\u6C89\u9ED8\u3002"
