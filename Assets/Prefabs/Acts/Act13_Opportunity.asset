  - dialogueIndex: 0
    isNarration: 0
    characterName: "\u5927\u91CE \u967D\u6597"
    dialogueText: "\u6B38\u6B38\u6B38\uFF0C\u807D\u8AAA\u4E86\u55CE\uFF1F\uFF01\u9031\u672B\u624D\u85DD\u6D3B\u52D5\u6709\u821E\u53F0\u7A7A\u6A94\uFF0C\u6211\u5011\u53EF\u4EE5\u8868\u6F14\uFF01\u6211\u8DDF\u8001\u5E2B\u8AAA\u4E86\uFF0C\u4ED6\u8AAA\u53EF\u4EE5\u501F\u7528\u97F3\u97FF\uFF01\u9019\u6B21\u4E00\u5B9A\u8981\u8B93\u5168\u6821\u770B\u5230\u6211\u5011\u7684\u6B4C\uFF01"
    choices: []
