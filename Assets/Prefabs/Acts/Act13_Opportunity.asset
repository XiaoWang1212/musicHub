    characterName: "\u767D\u77F3 \u900F\u7FBD"
    dialogueText: "\u793E\u8FA6\u5167\u6563\u843D\u8457\u6A02\u5668\u548C\u8B5C\u67B6\u3002\u5927\u91CE
