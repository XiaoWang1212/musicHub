  - dialogueIndex: 0
    isNarration: 0
    characterName: "\u5C71\u702C \u65E5\u5411"
    dialogueText: "\u592A\u68D2\u5566\uFF01\u6211\u8FEB\u4E0D\u53CA\u5F85\u6253\u9F13\u4E86\uFF01\u9019\u624D\u662F\u771F\u6B63\u7684\u97F3\u6A02\u793E\u561B\uFF01\u5F69\u6392\u5C31\u5148\u73A9\u7BC0\u594F\uFF0C\u6B63\u5F0F\u4E0A\u5834\u518D\u653E\u5927\u62DB\uFF01"
